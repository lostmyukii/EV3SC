<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VSLE Scratch-EV3 安装向导"
    Width="1080"
    Height="720"
    MinWidth="980"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F7"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DADADF" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#ECECF0" />
            <Setter Property="BorderBrush" Value="#DADADF" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock
                        Text="VSLE 安装"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}" />
                    <TextBlock
                        Text="Windows 内部测试向导"
                        FontSize="14"
                        Margin="0,6,0,0"
                        Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ListBox
                    x:Name="StepList"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                    <TextBlock
                                        Text="{Binding Number}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding StatusLabel}"
                                        FontSize="12"
                                        Margin="0,2,0,0"
                                        Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border
            Grid.Column="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        x:Name="StepTitle"
                        Text="欢迎"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}" />
                    <TextBlock
                        x:Name="StepSummary"
                        Margin="0,10,0,0"
                        FontSize="16"
                        LineHeight="24"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,30,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="本步进度"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="70" />
                                </Grid.ColumnDefinitions>
                                <ProgressBar
                                    x:Name="CurrentStepProgressBar"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Height="10"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    x:Name="CurrentStepProgressText"
                                    Grid.Column="1"
                                    Text="0%"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    TextAlignment="Right"
                                    Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <TextBlock
                                Text="完成条件"
                                Margin="0,12,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="CompletionConditionText"
                                Margin="0,4,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock
                                Text="当前位置"
                                Margin="0,10,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="HardwareLocationText"
                                Margin="0,4,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="自动执行"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="AutoActionsText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="需要你手动确认"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="ManualActionsText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock
                                Text="人工确认清单"
                                Margin="0,12,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <ListBox
                                x:Name="ManualConfirmationsList"
                                Margin="0,8,0,0"
                                BorderThickness="0"
                                Background="Transparent"
                                MaxHeight="132">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            Margin="0,4,0,4"
                                            Content="{Binding Label}"
                                            Tag="{Binding Key}"
                                            IsChecked="{Binding Checked, Mode=TwoWay}"
                                            FontSize="13"
                                            Foreground="{StaticResource TextBrush}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="3"
                        x:Name="Ev3SetupPanel"
                        Visibility="Collapsed"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="EV3 连接"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="连接方式" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="TransportComboBox" Grid.Row="0" Grid.Column="1" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="WiFi Full VSLE（WiFi 完整模式）" Tag="wifi-full-vsle" />
                                    <ComboBoxItem Content="Bluetooth Full VSLE（蓝牙完整模式）" Tag="bluetooth-full-vsle" />
                                    <ComboBoxItem Content="USB-assisted setup（USB 辅助设置）" Tag="usb-assisted" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="EV3 SSH 地址" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3HostTextBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SSH 用户" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3UserTextBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0" Text="robot" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="EV3 蓝牙地址" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3BluetoothAddressTextBox" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="4" Grid.Column="1" Text="SSH 密码由 Windows/OpenSSH 单独提示，不会写入安装向导证据。" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="4"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="当前状态"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="StatusText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock
                                Text="自动检查明细"
                                Margin="0,12,0,0"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <ListBox
                                x:Name="CheckItemsList"
                                Margin="0,8,0,0"
                                BorderThickness="0"
                                Background="Transparent"
                                MaxHeight="118">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,3">
                                            <TextBlock
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{StaticResource TextBrush}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{}{0}：{1}">
                                                        <Binding Path="Name" />
                                                        <Binding Path="Status" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                            <TextBlock
                                                Text="{Binding Detail}"
                                                FontSize="12"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="5"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18">
                        <StackPanel>
                            <TextBlock
                                Text="证据或结果"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="EvidenceText"
                                Margin="0,8,0,0"
                                FontFamily="Consolas"
                                FontSize="13"
                                LineHeight="21"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2" LastChildFill="False">
                    <TextBlock
                        x:Name="ProgressText"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource MutedTextBrush}" />
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            x:Name="BackButton"
                            Content="上一步"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="RetryButton"
                            Content="重试"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="ExportButton"
                            Content="导出诊断"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="ConfirmInstallButton"
                            Content="确认安装"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="ConfirmEv3InstallButton"
                            Content="确认安装 EV3"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="ContinueButton"
                            Content="下一步"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
