<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="VSLE Windows Setup Wizard"
    Width="1080"
    Height="720"
    MinWidth="980"
    MinHeight="640"
    WindowStartupLocation="CenterScreen"
    Background="#F5F5F7"
    FontFamily="Segoe UI">
    <Window.Resources>
        <SolidColorBrush x:Key="AccentBrush" Color="#007AFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#1D1D1F" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#6E6E73" />
        <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="BorderBrush" Color="#DADADF" />
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinWidth" Value="120" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            <Setter Property="Background" Value="#ECECF0" />
            <Setter Property="BorderBrush" Value="#DADADF" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            Grid.Column="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="22">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
                    <TextBlock
                        Text="VSLE Setup"
                        FontSize="30"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}" />
                    <TextBlock
                        Text="Windows internal testing wizard"
                        FontSize="14"
                        Margin="0,6,0,0"
                        Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
                <ListBox
                    x:Name="StepList"
                    BorderThickness="0"
                    Background="Transparent"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Width="24"
                                    Height="24"
                                    CornerRadius="12"
                                    Background="#E8F2FF"
                                    BorderBrush="{StaticResource AccentBrush}"
                                    BorderThickness="1"
                                    HorizontalAlignment="Left">
                                    <TextBlock
                                        Text="{Binding Number}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource AccentBrush}" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        Text="{Binding Title}"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource TextBrush}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        Text="{Binding Status}"
                                        FontSize="12"
                                        Margin="0,2,0,0"
                                        Foreground="{StaticResource MutedTextBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Border
            Grid.Column="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="18"
            Padding="30">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock
                        x:Name="StepTitle"
                        Text="Welcome"
                        FontSize="34"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource TextBrush}" />
                    <TextBlock
                        x:Name="StepSummary"
                        Margin="0,10,0,0"
                        FontSize="16"
                        LineHeight="24"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <Grid Grid.Row="1" Margin="0,30,0,24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border
                        Grid.Row="0"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="Automatic actions"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="AutoActionsText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="Manual teacher action"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="ManualActionsText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                LineHeight="22"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="2"
                        x:Name="Ev3SetupPanel"
                        Visibility="Collapsed"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="EV3 connection"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="160" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Transport" FontSize="13" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <ComboBox x:Name="TransportComboBox" Grid.Row="0" Grid.Column="1" Height="32" SelectedIndex="0">
                                    <ComboBoxItem Content="WiFi Full VSLE" Tag="wifi-full-vsle" />
                                    <ComboBoxItem Content="Bluetooth Full VSLE" Tag="bluetooth-full-vsle" />
                                    <ComboBoxItem Content="USB-assisted setup" Tag="usb-assisted" />
                                </ComboBox>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="EV3 SSH host" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3HostTextBox" Grid.Row="1" Grid.Column="1" Height="32" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="SSH user" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3UserTextBox" Grid.Row="2" Grid.Column="1" Height="32" Margin="0,10,0,0" Text="robot" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Bluetooth address" FontSize="13" Margin="0,10,0,0" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
                                <TextBox x:Name="Ev3BluetoothAddressTextBox" Grid.Row="3" Grid.Column="1" Height="32" Margin="0,10,0,0" />

                                <TextBlock Grid.Row="4" Grid.Column="1" Text="SSH authentication is requested by Windows/OpenSSH and is not written into wizard evidence." FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="3"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18"
                        Margin="0,0,0,14">
                        <StackPanel>
                            <TextBlock
                                Text="Current status"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="StatusText"
                                Margin="0,8,0,0"
                                FontSize="14"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="4"
                        Background="#F8F8FA"
                        CornerRadius="18"
                        Padding="18">
                        <StackPanel>
                            <TextBlock
                                Text="Evidence or result"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource TextBrush}" />
                            <TextBlock
                                x:Name="EvidenceText"
                                Margin="0,8,0,0"
                                FontFamily="Consolas"
                                FontSize="13"
                                LineHeight="21"
                                TextWrapping="Wrap"
                                Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <DockPanel Grid.Row="2" LastChildFill="False">
                    <TextBlock
                        x:Name="ProgressText"
                        DockPanel.Dock="Left"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Foreground="{StaticResource MutedTextBrush}" />
                    <WrapPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button
                            x:Name="BackButton"
                            Content="Back"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="RetryButton"
                            Content="Retry"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="ExportButton"
                            Content="Export diagnostics"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            x:Name="ConfirmInstallButton"
                            Content="Confirm Install"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="ConfirmEv3InstallButton"
                            Content="Confirm EV3 Install"
                            Visibility="Collapsed"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="ContinueButton"
                            Content="Continue"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </WrapPanel>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
